{
  "id": "https://colophon-editor.pages.dev/",
  "name": "Colophon",
  "short_name": "Colophon",
  "description": "Editor EPUB gratuito: modifica metadati, copertina, stile, indice e accessibilità nel browser, anche offline. I libri restano sul tuo dispositivo.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafa",
  "theme_color": "#a6eeff",
  "categories": [
    "productivity",
    "utilities",
    "books"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "docs/screenshots/02-metadati.png",
      "sizes": "824x1784",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Metadati e copertina"
    },
    {
      "src": "docs/screenshots/03-stile-anteprima.png",
      "sizes": "824x1784",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Stile e anteprima"
    },
    {
      "src": "docs/screenshots/05-ortografia.png",
      "sizes": "824x1784",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Controllo ortografico"
    },
    {
      "src": "docs/screenshots/13-accessibilita.png",
      "sizes": "824x1784",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Controllo di accessibilità"
    },
    {
      "src": "docs/screenshots/wide-01-metadati.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Metadati e copertina"
    },
    {
      "src": "docs/screenshots/wide-02-stile-anteprima.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Stile e anteprima"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/epub+zip": [
          ".epub"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "shortcuts": [
    {
      "name": "Apri un EPUB",
      "short_name": "Apri",
      "description": "Scegli un file EPUB da modificare",
      "url": "./index.html?a=open",
      "icons": [
        {
          "src": "shortcut-open.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Privacy e condizioni",
      "short_name": "Privacy",
      "description": "Informativa privacy e condizioni d'uso",
      "url": "./index.html?a=privacy",
      "icons": [
        {
          "src": "shortcut-privacy.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lingua",
      "short_name": "Lingua",
      "description": "Cambia la lingua dell'interfaccia",
      "url": "./index.html?a=lang",
      "icons": [
        {
          "src": "shortcut-lang.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}